# ── Required ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=mysql://user:password@host:3306/smc

# ── Site ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000
VITE_APP_ID=smc-independent
NODE_ENV=development
PORT=3000

# ── AI provider (OpenAI-compatible chat completions) ────────────────────────
# OpenRouter: https://openrouter.ai/api   OpenAI: https://api.openai.com
LLM_API_URL=https://openrouter.ai/api
LLM_API_KEY=
LLM_MODEL=google/gemini-2.5-flash

# ── Voice transcription (OpenRouter has NO audio API — use OpenAI or Groq) ──
# Groq: https://api.groq.com/openai  model whisper-large-v3
TRANSCRIPTION_API_URL=https://api.openai.com
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# ── Image generation (optional — infographics disabled if unset) ────────────
IMAGE_API_URL=https://api.openai.com
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# ── File storage (Cloudflare R2 or any S3-compatible) ───────────────────────
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
STORAGE_BUCKET=smc-files
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
# Public bucket domain (R2 dashboard → bucket → Settings → Public access)
STORAGE_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ── Email (Resend: https://resend.com — free tier 100 emails/day) ───────────
RESEND_API_KEY=
EMAIL_FROM=Smart Medical Consultant <onboarding@resend.dev>
OWNER_EMAIL=jalalkhashman1974@gmail.com

# ── LiveAvatar / HeyGen — interactive video doctor on the intake page ───────
# Optional: leave LIVEAVATAR_API_KEY empty and the intake session automatically
# runs in voice-only mode (browser speech). Nothing else breaks.
#   1. Sign up at https://www.liveavatar.com
#   2. API key:   dashboard → Settings → API keys
#   3. Avatar id: dashboard → Avatars → pick one → copy its UUID
#   4. Voice id:  optional — omit to use the avatar's default voice
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=
# Sandbox sessions are free but watermarked. Set to false on a paid plan.
LIVEAVATAR_SANDBOX=true

# ── Optional ─────────────────────────────────────────────────────────────────
CALLMEBOT_API_KEY=

# ── Sign in with Google (optional) ──────────────────────────────────────────
# The button appears only when BOTH values are set, so a half-configured
# deployment never shows a button that dead-ends.
#   https://console.cloud.google.com → APIs & Services → Credentials
#   → Create OAuth client ID → Web application
#   Authorised redirect URI (must match exactly):
#     https://YOURDOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
